--- !u!114 &296497712
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 296497710}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Qui est-il ?\nJojo ancien maitre de la Cit\xE9 de Vapuris, a fait prosp\xE9rer
    la cit\xE9 pendant vingts ans , les citoyens le respecte comme un h\xE9ros.\n\nSon
    Histoire\nAutrefois maitre de la cit\xE9 Vapuris, Jojo est d\xE9tronn\xE9 par
    Anger et lui jure fid\xE9lit\xE9 pour \xE9viter de finir consumm\xE9 par la catastrophe
    \"Grande Surcharge\".\n\nSon But\nTrouver un adversaire capable de le d\xE9livrer
    de l'emprise de Anger."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: fdb6cc9a5fa304bc0a5e3d620dfcc96a, type: 2}
  m_sharedMaterial: {fileID: -7697690669607560752, guid: fdb6cc9a5fa304bc0a5e3d620dfcc96a, type: 2}
