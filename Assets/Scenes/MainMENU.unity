  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Le Blob est un ancien officier de la milice urbaine de Vaporis dont l'armure
    a \xE9t\xE9 directement greff\xE9e aux valves de la ville. \n\nSon Histoire \nL\xE2che
    ou bris\xE9 par la peur, il a jur\xE9 fid\xE9lit\xE9 \xE0 Anger lors de la prise
    de contr\xF4le des conduits centraux pour \xE9viter d'\xEAtre consum\xE9. \n\nSon
    But\nTraquer et capturer tout citoyen tentant de saboter la pression, avec pour
    priorit\xE9 absolue l'arrestation d'Ingenio."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: fdb6cc9a5fa304bc0a5e3d620dfcc96a, type: 2}
  m_sharedMaterial: {fileID: -7697690669607560752, guid: fdb6cc9a5fa304bc0a5e3d620dfcc96a, type: 2}
